<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows SDK version gives access to Windows' location service (Windows.Devices.Geolocation). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>GeneradorQR</AssemblyName>
    <RootNamespace>GeneradorQR.App</RootNamespace>
    <Version>1.1.0</Version>
    <!-- Shown in the exe's Properties > Details. -->
    <Authors>Sebastian Gomez</Authors>
    <Company>Sebastian Gomez</Company>
    <Product>Generador QR</Product>
    <Copyright>© 2026 Sebastian Gomez</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Keep the published folder to the single exe (no package XML docs next to it). -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeneradorQR.Core\GeneradorQR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window/taskbar icon and sidebar logo; ApplicationIcon above only sets the exe's icon in Explorer. -->
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
    <!-- Location map page and Leaflet, served to WebView2 from inside the exe (see MapaSelector). -->
    <EmbeddedResource Include="Assets\Mapa\*.html;Assets\Mapa\*.js;Assets\Mapa\*.css" LogicalName="Mapa/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

</Project>
