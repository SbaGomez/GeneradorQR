<Window x:Class="GeneradorQR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GeneradorQR.App.ViewModels"
        xmlns:vistas="clr-namespace:GeneradorQR.App.Views"
        Title="Generador QR" Width="1120" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Icon="/Assets/app.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PegarImagenCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:GeneradorViewModel}">
            <vistas:GeneradorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VerificadorViewModel}">
            <vistas:VerificadorView/>
        </DataTemplate>

        <!-- Sidebar entries. -->
        <DataTemplate x:Key="ItemNav">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icono}" FontFamily="{StaticResource Iconos}" FontSize="16" Width="22" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Nombre}" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="Nav" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,9" Margin="0,1"
                                BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- The verifier sits apart from the kinds of QR. -->
                <DataTrigger Binding="{Binding Nombre}" Value="Verificar QR">
                    <Setter Property="Margin" Value="0,14,0,0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="/Assets/app.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Generador QR" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0">
                    <TextBlock Style="{StaticResource Hint}" Margin="0" FontSize="11.5"
                               Text="Códigos estáticos: llevan el destino final adentro, sin pasar por ningún servicio. No vencen nunca."/>
                    <Border Height="1" Background="{StaticResource SubtleBorderBrush}" Margin="0,12,0,10"/>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource MutedTextBrush}">
                        <Run Text="Hecho por"/>
                        <Run Text="Sebastian Gomez" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="CREAR" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" Margin="12,0,0,6"/>
                    <ListBox ItemsSource="{Binding Secciones}" SelectedItem="{Binding Seccion}"
                             ItemTemplate="{StaticResource ItemNav}" ItemContainerStyle="{StaticResource Nav}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Pantalla}" Focusable="False"/>
    </Grid>
</Window>
