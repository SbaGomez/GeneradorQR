<UserControl x:Class="GeneradorQR.App.Views.MapaSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource InputBorderBrush}"
            Background="{StaticResource DeskBrush}" ClipToBounds="True">
        <Grid>
            <TextBlock x:Name="Cargando" Text="Cargando mapa…" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="24"/>
            <!-- Composition control: drawn inside WPF, so it scrolls and clips like any other element. -->
            <wv2:WebView2CompositionControl x:Name="Web" Visibility="Hidden"/>
        </Grid>
    </Border>
</UserControl>
