<UserControl x:Class="GeneradorQR.App.Views.VerificadorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:GeneradorQR.Core;assembly=GeneradorQR.Core"
             xmlns:vistas="clr-namespace:GeneradorQR.App.Views"
             AllowDrop="True" Drop="AlSoltar" DragOver="AlArrastrar" Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="OcultoSiNulo" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,24" MaxWidth="820" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Iconos}" FontSize="22"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,2,12,0"/>
                <TextBlock Text="Verificar QR" Style="{StaticResource PageTitle}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Descripcion}"
                       Text="Cargá la imagen de un QR (uno tuyo, una foto o una captura de un folleto) para ver exactamente qué contiene y si va directo a su destino o pasa por un acortador o una plataforma intermedia."/>

            <!-- Drop zone -->
            <Grid MinHeight="170">
                <Rectangle x:Name="Zona" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="5 3"
                           Stroke="{StaticResource InputBorderBrush}" Fill="{StaticResource SidebarBrush}"/>
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="130" Height="130" CornerRadius="8" Background="White" Margin="0,0,20,0"
                            BorderBrush="{StaticResource SubtleBorderBrush}" BorderThickness="1"
                            Tag="{Binding Imagen}" Style="{StaticResource OcultoSiNulo}">
                        <Image Source="{Binding Imagen}" Margin="6"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Iconos}" FontSize="34" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Arrastrá la imagen acá, o" HorizontalAlignment="Center" FontSize="14"
                                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding AbrirArchivoCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Abrir imagen"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding PegarCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Pegar (Ctrl+V)"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="PNG, JPG, BMP, GIF, TIFF o WEBP" HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock Text="Leyendo…" Margin="0,16,0,0" Foreground="{StaticResource MutedTextBrush}"
                       Visibility="{Binding Leyendo, Converter={StaticResource BoolToVisibility}}"/>

            <Border Margin="0,16,0,0" Padding="14" CornerRadius="8" Background="#FBEAEA" BorderBrush="#F2C4C4" BorderThickness="1"
                    Tag="{Binding Error}" Style="{StaticResource OcultoSiNulo}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" FontSize="13.5"/>
            </Border>

            <!-- One card per QR found -->
            <ItemsControl ItemsSource="{Binding Resultados}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Tarjeta" Margin="0,16,0,0" Padding="18" CornerRadius="10" BorderThickness="1"
                                Background="{StaticResource InfoFondoBrush}" BorderBrush="{StaticResource SubtleBorderBrush}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Icono" Text="&#xE946;" FontFamily="{StaticResource Iconos}" FontSize="22"
                                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="Titulo" Text="{Binding Analisis.Titulo}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Analisis.Detalle}" FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="10,3" VerticalAlignment="Top" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Analisis.Tipo}" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Contenido" Style="{StaticResource InputLabel}" Margin="0,14,0,4"/>
                                <TextBox Text="{Binding Contenido, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
                                         TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                            Command="{Binding DataContext.CopiarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Copiar contenido"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.AbrirEnlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Visibility>
                                            <Binding Path="Analisis.Enlace"
                                                     Converter="{x:Static vistas:Visible.SiHay}"/>
                                        </Button.Visibility>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Iconos}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Abrir"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Analisis.Veredicto}" Value="{x:Static core:Veredicto.Directo}">
                                <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource OkFondoBrush}"/>
                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource OkBordeBrush}"/>
                                <Setter TargetName="Icono" Property="Text" Value="&#xE930;"/>
                                <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Analisis.Veredicto}" Value="{x:Static core:Veredicto.Intermediario}">
                                <Setter TargetName="Tarjeta" Property="Background" Value="{StaticResource AvisoFondoBrush}"/>
                                <Setter TargetName="Tarjeta" Property="BorderBrush" Value="{StaticResource AvisoBordeBrush}"/>
                                <Setter TargetName="Icono" Property="Text" Value="&#xE7BA;"/>
                                <Setter TargetName="Icono" Property="Foreground" Value="{StaticResource AvisoTextoBrush}"/>
                                <Setter TargetName="Titulo" Property="Foreground" Value="{StaticResource AvisoTextoBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Estado}" Foreground="{StaticResource SuccessBrush}" FontSize="12.5" Margin="0,12,0,0"
                       Tag="{Binding Estado}" Style="{StaticResource OcultoSiNulo}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
