<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GeneradorQR.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure managed encoder (no System.Drawing): renders PNG bytes and SVG text directly. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Decoder for the verifier (reads QRs from saved images, photos and screenshots). -->
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

</Project>
